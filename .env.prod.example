APP_NAME=Boursa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Nouakchott
APP_URL=https://api.boursa.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=boursa
DB_USERNAME=boursa
DB_PASSWORD=CHANGE_ME_strong_password

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
CACHE_PREFIX=boursa
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@boursa.mr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=boursa
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=boursa-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://media.boursa.example.com/boursa-media

SANCTUM_STATEFUL_DOMAINS=boursa.example.com,api.boursa.example.com
SESSION_DOMAIN=.boursa.example.com
